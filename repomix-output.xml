                          title="Calculadora Estratégica"
                        >
                          <Calculator size={16} />
                        </button>
                        <button
                          onClick={(e) => { e.stopPropagation(); navigate(`/parecer/${client.id}`); }}
                          className="p-2 rounded-lg bg-slate-50 text-slate-600 hover:bg-purple-50 hover:text-purple-600 transition-colors"
                          title="Parecer IA"
