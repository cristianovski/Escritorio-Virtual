                      </div>

                      <div className="w-px h-6 bg-slate-200"></div>

                      {/* Grupo 2: Calculadora e Parecer IA */}
                      <div className="flex gap-1">
                        <button
                          onClick={(e) => { e.stopPropagation(); navigate(`/analise/${client.id}`); }}
