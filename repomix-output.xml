<file path="src/pages/analysis/MasterReportPage.tsx">
import {
  ArrowLeft,
  Printer,
  CheckSquare,
  Square,
  FileText,
  Calendar,
  Scale,
  Brain,
  TrendingUp,
  User,
  CheckCircle,
  AlertTriangle,
} from 'lucide-react';
import { useMasterReport } from '../../hooks/useMasterReport';
